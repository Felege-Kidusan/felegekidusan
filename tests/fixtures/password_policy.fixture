<?php
$root = rtrim($argv[1] ?? dirname(__DIR__, 2), '/\\');
require_once $root . '/admin/backend/services/PasswordPolicy.php';

use App\Services\PasswordPolicy;

$cases = [
    'valid_passphrase' => PasswordPolicy::errors('correct horse battery staple'),
    'valid_unicode' => PasswordPolicy::errors(str_repeat('ሀ', 12)),
    'too_short' => PasswordPolicy::errors('short-pass'),
    'too_long' => PasswordPolicy::errors(str_repeat('a', 73)),
    'common' => PasswordPolicy::errors('password1234'),
    'nul_byte' => PasswordPolicy::errors("valid-looking\0password"),
    'whitespace' => PasswordPolicy::errors(str_repeat(' ', 12)),
];

echo json_encode([
    'minimum' => PasswordPolicy::MIN_CHARACTERS,
    'maximum_bytes' => PasswordPolicy::MAX_BYTES,
    'cases' => $cases,
], JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR), PHP_EOL;
