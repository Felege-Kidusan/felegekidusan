Options -Indexes -MultiViews
# SSMS — production cache policy (standard HTTP caching)
# Static assets are revalidated on every deploy so a `git pull` is always
# reflected in the browser without manual cache clearing. HTML is never cached.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html              "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType text/css               "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "0"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

    # HTML/PHP: always revalidate
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # CSS/JS: cache briefly but revalidate (ETag / Last-Modified) so a file
    # change on disk (deploy) is picked up on next load.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# Protect sensitive paths
<FilesMatch "^\.git">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^admin/migrations/ - [F,L]
    RewriteRule ^backend/migrations/ - [F,L]
    RewriteRule ^admin/get_schema\.php$ - [F,L]
    RewriteRule ^admin/id_cards/qr_diagnostic\.php$ - [F,L]
    RewriteRule (^|/)leak_detector\.php$ - [F,L]
    RewriteRule (^|/)composer\.(json|lock)$ - [F,L]
    # Repository artefacts are not web content: schema/migration SQL, documentation,
    # test suites, operator scripts, CLI tools, vendored libraries, CI config and the
    # Flutter source tree. Serving them discloses internals (schema, audit evidence).
    RewriteRule ^(sql|docs|tests|scripts|tools|vendor|Mobile|\.github)(/|$) - [F,L]
    RewriteRule (^|/)(database_schema\.sql|README\.md|ENTERPRISE_SECURITY_AUDIT_REPORT\.md|env\.example\.php|\.editorconfig|\.gitignore)$ - [F,L]
    RewriteRule \.(sql|md|sh|py|lock|ya?ml|dist)$ - [F,L]

    # Browser aliases are dispatched through a finite PHP registry, NOT by
    # appending .php to arbitrary input. API/assets/real directories keep
    # their original handlers. Child admin rules repeat this capability flag.
    RewriteRule ^ - [E=FKSS_BROWSER_ROUTES:1]
    # Retain the mount prefix when Apache Alias rewrites SCRIPT_NAME.
    RewriteCond %{REQUEST_URI} ^((?:/[A-Za-z0-9_-]+)*)/(?:verify-member|(?:frontend/pages|monitor)/[a-z][a-z0-9-]*)$
    RewriteRule ^ - [E=FKSS_BROWSER_PREFIX:%1]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(?:verify-member|(?:frontend/pages|monitor)/[a-z][a-z0-9-]*)$ browser_page.php [END]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
