# SSMS — production cache policy (standard HTTP caching)
# Static assets are revalidated on every deploy so a `git pull` is always
# reflected in the browser without manual cache clearing. HTML is never cached.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html              "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType text/css               "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    # HTML/PHP: always revalidate
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # CSS/JS: cache briefly but revalidate (ETag / Last-Modified) so a file
    # change on disk (deploy) is picked up on next load.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# Protect sensitive paths
<FilesMatch "^\.git">
    Order allow,deny
    Deny from all
</FilesMatch>
