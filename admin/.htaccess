# Pass Authorization header to PHP (Apache strips it by default)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # This directory has its own rewrite rules. Repeat the relevant denials
    # here: parent per-directory rewrite rules are NOT automatically inherited.
    RewriteRule ^migrations(?:/|$) - [F,L,NC]
    # backup.php/download_backup.php are active, authenticated UI workflows.
    RewriteRule ^tools/(?:migrate_identity_codes|repair_user_role)\.php$ - [F,L,NC]
    RewriteRule ^(?:id_cards/libs|backend/pdf/tcpdf)/.*\.php$ - [F,L,NC]
    RewriteRule ^(?:backend/generate_hash|get_schema|id_cards/qr_diagnostic|leak_detector)\.php$ - [F,L,NC]
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Keep denials above routing. Unknown slugs return 404 in the explicit
    # page registry; APIs, existing files and directories are never inferred.
    RewriteRule ^ - [E=FKSS_BROWSER_ROUTES:1]
    # Retain the deployment prefix across ../browser_page.php under Alias.
    RewriteCond %{REQUEST_URI} ^((?:/[A-Za-z0-9_-]+)*)/admin/
    RewriteRule ^ - [E=FKSS_BROWSER_PREFIX:%1]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(?:(?:dashboards|id_cards)/)?[a-z][a-z0-9-]*$ ../browser_page.php [END]
</IfModule>

# CORS for mobile API — handled by PHP code (api_mobile.php) which checks origins.
# Do NOT set Access-Control-Allow-Origin here at the Apache level because it
# overrides the PHP origin checks with a blanket wildcard, defeating the security.
<Files "api_mobile.php">
    <IfModule mod_headers.c>
        Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
        Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    </IfModule>
</Files>

# Block direct access to sensitive files in web root
<FilesMatch "\.(sql|zip|gz|tar|bak|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    Order deny,allow
    Deny from all
</FilesMatch>

Options -Indexes -MultiViews
